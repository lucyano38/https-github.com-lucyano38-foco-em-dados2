rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /leads/{leadId} {
      allow read, write: if true;
    }
    match /crm_leads/{leadId} {
      allow read, write: if true;
    }
    match /analysis_reports/{reportId} {
      allow read, write: if true;
    }
  }
}
