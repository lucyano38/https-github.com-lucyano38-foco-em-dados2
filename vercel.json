{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "focoemdados.com.br"
        }
      ],
      "destination": "https://www.focoemdados.com.br/:path*",
      "permanent": true
    }
  ]
}
